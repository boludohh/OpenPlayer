<resources>
    <!-- Variante oscura del tema base para SplashActivity y MainActivity.
         Hereda de Theme.Material.NoActionBar (la versión oscura del tema
         Material base), garantizando que los recursos del sistema y los
         atributos por defecto usen la paleta oscura. -->
    <style name="Theme.ComposeEmptyActivity" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Variante oscura del tema de splash.
         windowBackground #000000 coincide exactamente con DarkBackground
         según el documento de colores de OpenPlayer (fondo principal del
         tema Oscuro, negro puro optimizado para pantallas AMOLED).
         La transición desde el splash al contenido principal de Compose
         es completamente imperceptible al compartir el mismo color. -->
    <style name="Theme.Splash" parent="Theme.ComposeEmptyActivity">
        <item name="android:windowBackground">#FF000000</item>
    </style>
</resources>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
      Logo oficial de NokliPlayer.
      Equivalente fiel al SVG original con todos los detalles preservados:
      - Grupo externo escalado 0.92x centrado en (12,12).
      - Rect rojo #C1121F con esquinas redondeadas rx=5.5 ry=5.5.
      - Grupo interno escalado 0.8817x centrado en (12,12) para el símbolo.
      - Símbolo blanco con stroke de 3 y linecap redondeado.
      El clipPath del SVG original se omite porque el símbolo (0.8817)
      es más pequeño que el rect de fondo (0.92) y sus coordenadas
      extremas nunca alcanzan los bordes del rect.
    -->

    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.92"
        android:scaleY="0.92">

        <!-- Fondo rojo con esquinas redondeadas -->
        <path
            android:fillColor="#1545bf"
            android:pathData="M5.5,0L18.5,0A5.5,5.5 0,0 1,24 5.5L24,18.5A5.5,5.5 0,0 1,18.5 24L5.5,24A5.5,5.5 0,0 1,0 18.5L0,5.5A5.5,5.5 0,0 1,5.5 0z"/>

        <!-- Símbolo blanco, escalado 0.8817x desde el centro -->
        <group
            android:pivotX="12"
            android:pivotY="12"
            android:scaleX="0.8817"
            android:scaleY="0.8817">

            <path
                android:fillColor="#00000000"
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="3"
                android:strokeLineCap="round"
                android:pathData="M11.058,4c-4.135,0.457 -7.351,4.162 -7.351,8.73a8.27,8.27 0,0 0,13.784 6.164c4.01,-3.588 1.378,-10.55 -2.757,-10.55h-1.228A4.285,4.285 0,0 0,9.22 12.63a2.857,2.857 0,0 0,2.856 2.856h0.13a2.986,2.986 0,0 0,2.986 -2.986V5.796a1.796,1.796 0,0 1,3.29 -0.996l0.386,0.578"/>
        </group>
    </group>
</vector>